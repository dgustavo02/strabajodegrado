<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${empty tituloPagina ? 'Trabajos de Grado UTS' : tituloPagina}"/></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="${ctx}/assets/css/estilos-globales.css" rel="stylesheet">
  <c:if test="${not empty cssExtra}"><link href="${ctx}/assets/css/${cssExtra}.css" rel="stylesheet"></c:if>
</head>
<body class="<c:out value='${bodyClass}'/>">
