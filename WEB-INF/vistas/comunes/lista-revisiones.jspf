<%-- Lista de trabajos del docente según su función. Variables: funcionReq, turnoEstado, vistaRevision, tituloLista --%>
<sql:query var="lista">
  SELECT t.id, t.estado, f.nombre AS fase, COALESCE(i.titulo, pe.titulo) AS titulo, COALESCE(i.modalidad, pe.modalidad) AS modalidad,
         (SELECT GROUP_CONCAT(u.nombre SEPARATOR ', ') FROM trabajo_estudiantes te JOIN users u ON u.id = te.estudiante_id WHERE te.trabajo_id = t.id) AS estudiantes,
         (SELECT COUNT(*) FROM entregas e WHERE e.trabajo_id = t.id AND e.estado = ?) AS por_revisar
    FROM trabajo_docentes td JOIN trabajos_grado t ON t.id = td.trabajo_id JOIN asignaciones_ideas ai ON ai.id = t.asignacion_idea_id
    LEFT JOIN ideas i ON i.id = ai.idea_id LEFT JOIN propuestas_estudiantes pe ON pe.id = ai.propuesta_estudiante_id
    LEFT JOIN fases f ON f.id = t.fase_actual_id
   WHERE td.docente_id = ? AND td.funcion = ?
   ORDER BY (por_revisar > 0) DESC, t.updated_at DESC
  <sql:param value="${turnoEstado}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${funcionReq}"/>
</sql:query>
<div class="page-header"><h1><c:out value="${tituloLista}"/></h1><p>Trabajos en los que fuiste designado como ${funcionReq}.</p></div>
<div class="panel">
  <div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Trabajo</th><th>Estudiante(s)</th><th>Fase</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <c:forEach var="t" items="${lista.rows}"><tr>
        <td><c:out value="${t.titulo}"/><br><small class="text-muted"><c:out value="${t.modalidad}"/></small></td>
        <td><c:out value="${empty t.estudiantes ? '—' : t.estudiantes}"/></td>
        <td><c:out value="${empty t.fase ? '—' : t.fase}"/></td>
        <td><span class="estado" data-estado="${t.estado}">${t.estado}</span><c:if test="${t.por_revisar gt 0}"> <span class="estado" data-estado="Pendiente">Por revisar</span></c:if></td>
        <td class="text-end"><a class="btn btn-sm ${t.por_revisar gt 0 ? 'btn-primary' : 'btn-outline-secondary'}" href="${ctx}/panel.jsp?v=${vistaRevision}&id=${t.id}">${t.por_revisar gt 0 ? 'Revisar' : 'Ver'}</a></td>
      </tr></c:forEach>
      <c:if test="${lista.rowCount eq 0}"><tr><td colspan="5" class="text-center text-muted py-4">No tienes trabajos asignados con esta función.</td></tr></c:if>
    </tbody></table></div>
</div>
