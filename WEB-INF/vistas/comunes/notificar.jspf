<%-- Notifica a un usuario. Variables: nUsuario, nTitulo, nMensaje, nTipo --%>
<sql:update>INSERT INTO notificaciones (usuario_id, titulo, mensaje, tipo) VALUES (?, ?, ?, ?)
  <sql:param value="${nUsuario}"/><sql:param value="${nTitulo}"/><sql:param value="${nMensaje}"/><sql:param value="${nTipo}"/>
</sql:update>
